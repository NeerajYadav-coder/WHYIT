# ── Database ─────────────────────────────────────────────────────
# Replace with your real PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whyit?schema=public"

# ── AI Provider ───────────────────────────────────────────────────
# Selects the active provider. Supported: "groq" | "openai"
AI_PROVIDER="groq"

# Default model used when no override is specified
AI_DEFAULT_MODEL="llama-3.3-70b-versatile"

# ── Groq API Key ──────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key-here"

# ── OpenAI (optional fallback) ────────────────────────────────────
OPENAI_API_KEY=""

# ── Anthropic (reserved) ──────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Google Gemini (reserved) ──────────────────────────────────────
GEMINI_API_KEY=""
